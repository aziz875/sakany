generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  LANDLORD
}

enum RoomType {
  CHAMBRE_COLOC
  STUDIO
  APPARTEMENT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                      String    @id @default(cuid())
  fullName                String
  email                   String    @unique
  passwordHash            String
  phone                   String
  role                    UserRole
  schoolVerified          Boolean   @default(false)
  isEmailVerified         Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiresAt DateTime?
  resetToken              String?
  resetTokenExpiresAt     DateTime?
  failedLoginAttempts     Int       @default(0)
  lockoutUntil            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  listings      Listing[]
  reviews       Review[]
  refreshTokens RefreshToken[]
  applications  Application[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Listing {
  id               String   @id @default(cuid())
  landlordId       String
  title            String
  description      String
  lat              Float
  lng              Float
  distanceToCampus Float
  pricePerMonth    Int
  roomType         RoomType
  furnished        Boolean  @default(false)
  verified         Boolean  @default(false)
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  landlord     User          @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  photos       Photo[]
  reviews      Review[]
  applications Application[]

  @@index([pricePerMonth])
  @@index([roomType])
  @@index([distanceToCampus])
  @@index([verified])
  @@index([featured])
}

model Photo {
  id        String @id @default(cuid())
  listingId String
  url       String
  sortOrder Int    @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  listingId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Application {
  id        String   @id @default(cuid())
  studentId String
  listingId String
  status    ApplicationStatus @default(PENDING)
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([studentId, listingId])
  @@index([studentId])
  @@index([listingId])
}
